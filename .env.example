# ─── MediaPipe ────────────────────────────────────────────────────────────────
# URL do WASM do MediaPipe (padrão: CDN jsDelivr)
# VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.20/wasm

# URL do modelo de detecção facial (padrão: Google Cloud Storage)
# VITE_MEDIAPIPE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task

# ─── App ──────────────────────────────────────────────────────────────────────
# Largura máxima do canvas de exportação em píxeis (padrão: 900)
# VITE_CANVAS_MAX_WIDTH=900
